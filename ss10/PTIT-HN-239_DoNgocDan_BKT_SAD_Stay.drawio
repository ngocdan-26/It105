  <diagram id="n-B1yjgPr3ADTPNoK0AT" name="Trang-2">
    <mxGraphModel dx="1709" dy="737" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle CLASS DIAGRAM - RIKKEI BOOTCAMP\n\nskinparam classAttributeIconSize 0\n\n&#39; =========================\n&#39; USER\n&#39; =========================\n\nclass User {\n    - userId : String\n    - fullName : String\n    - email : String\n    - password : String\n    --\n    + login()\n    + logout()\n    + updateProfile()\n}\n\nclass Student {\n    - studentId : String\n    - phone : String\n    - status : String\n    --\n    + joinGroup()\n    + submitAssignment()\n    + scanQRCode()\n}\n\nclass Instructor {\n    - instructorId : String\n    - specialization : String\n    --\n    + createCourse()\n    + createAssignment()\n    + viewAttendance()\n}\n\n&#39; Inheritance\nUser &lt;|-- Student\nUser &lt;|-- Instructor\n\n\n&#39; =========================\n&#39; COURSE\n&#39; =========================\n\nclass Course {\n    - courseId : String\n    - courseName : String\n    - description : String\n    - duration : int\n    - status : String\n    --\n    + createSchedule()\n    + updateCourse()\n    + getCourseInfo()\n}\n\nclass Schedule {\n    - scheduleId : String\n    - studyDate : Date\n    - startTime : Time\n    - endTime : Time\n    - sessionType : String\n    --\n    + createSchedule()\n    + updateSchedule()\n    + checkTime()\n}\n\nclass LabRoom {\n    - roomId : String\n    - roomName : String\n    - location : String\n    - capacity : int\n    - status : String\n    --\n    + checkAvailability()\n    + reserveRoom()\n    + releaseRoom()\n}\n\n&#39; Composition\nCourse \&quot;1\&quot; *-- \&quot;1..*\&quot; Schedule\n\n&#39; Association\nSchedule \&quot;0..*\&quot; -- \&quot;1\&quot; LabRoom\n\n\n&#39; =========================\n&#39; QR CODE\n&#39; =========================\n\nclass QRCode {\n    - qrId : String\n    - qrValue : String\n    - createdAt : DateTime\n    - expiredAt : DateTime\n    - status : String\n    --\n    + generateQR()\n    + validateQR()\n    + expireQR()\n}\n\nclass Attendance {\n    - attendanceId : String\n    - scanTime : DateTime\n    - deviceId : String\n    - ipAddress : String\n    - status : String\n    --\n    + scanQR()\n    + validateAttendance()\n    + checkDuplicateScan()\n}\n\n&#39; Composition\nSchedule \&quot;1\&quot; *-- \&quot;1..*\&quot; QRCode\n\n&#39; Association\nStudent \&quot;1\&quot; -- \&quot;0..*\&quot; Attendance\nQRCode \&quot;1\&quot; -- \&quot;0..*\&quot; Attendance\n\n\n&#39; =========================\n&#39; STUDY GROUP\n&#39; =========================\n\nclass StudyGroup {\n    - groupId : String\n    - groupName : String\n    - createdAt : DateTime\n    - status : String\n    - dissolvedAt : DateTime\n    --\n    + addMember()\n    + removeMember()\n    + assignLeader()\n    + dissolveGroup()\n}\n\nclass Assignment {\n    - assignmentId : String\n    - title : String\n    - description : String\n    - deadline : DateTime\n    - submittedAt : DateTime\n    - status : String\n    --\n    + createAssignment()\n    + submitAssignment()\n    + updateAssignment()\n    + viewSubmission()\n}\n\n&#39; Aggregation\nStudyGroup \&quot;1\&quot; o-- \&quot;1..*\&quot; Student\n\n&#39; Association\nStudyGroup \&quot;1\&quot; -- \&quot;0..*\&quot; Assignment\n\n\n&#39; =========================\n&#39; OTHER ASSOCIATIONS\n&#39; =========================\n\nInstructor \&quot;1\&quot; -- \&quot;0..*\&quot; Course\n\nStudent \&quot;0..*\&quot; -- \&quot;0..*\&quot; Course\n\nStudent \&quot;1\&quot; -- \&quot;0..*\&quot; Assignment\n\n\n&#39; =========================\n&#39; NOTES\n&#39; =========================\n\nnote right of StudyGroup\n    status:\n    ACTIVE\n    DISSOLVED\n\n    Khi nhóm giải tán:\n    - Không xóa Student\n    - Không xóa Assignment\n    - Lưu dissolvedAt\n    - Assignment cũ chuyển ARCHIVED\n    - Student có thể tham gia nhóm mới\nend note\n\nnote right of Attendance\n    Lưu thông tin:\n    - scanTime\n    - deviceId\n    - ipAddress\n\n    Kiểm tra:\n    - QR hết hạn\n    - Quét trùng\n    - Gian lận thiết bị\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="V-gXnfABlThgrkvuWZ9G-1">
