      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Rikkei Logistics Express - Luồng Phát Đơn Cho Tài Xế\n\nactor Sender as \&quot;Người gửi\&quot;\nparticipant SenderApp\nparticipant OrderService\nparticipant DispatchService\nparticipant DriverApp\nactor Driver as \&quot;Tài xế\&quot;\nparticipant TimeoutScheduler\n\nSender -&gt; SenderApp : Tạo đơn giao hỏa tốc\nSenderApp -&gt; OrderService : createOrder()\nactivate OrderService\n\nOrderService --&gt; SenderApp : orderConfirmed()\ndeactivate OrderService\n\nSenderApp --&gt; Sender : Hiển thị xác nhận đơn\n\nOrderService -&gt;&gt; DispatchService : notifyNewOrder()\nactivate DispatchService\n\nDispatchService -&gt;&gt; DriverApp : pushOrder()\nDispatchService -&gt;&gt; TimeoutScheduler : startTimer(30s)\n\nalt Tài xế đồng ý nhận đơn\n    Driver -&gt; DriverApp : Nhấn \&quot;Đồng ý\&quot;\n    DriverApp --&gt; DispatchService : acceptOrder()\n\n    DispatchService -&gt;&gt; TimeoutScheduler : cancelTimer()\n\n    DispatchService -&gt;&gt; DriverApp : assignOrderSuccess()\n\nelse Tài xế từ chối nhận đơn\n    Driver -&gt; DriverApp : Nhấn \&quot;Từ chối\&quot;\n    DriverApp --&gt; DispatchService : rejectOrder()\n\n    DispatchService -&gt;&gt; DispatchService : findAnotherDriver()\n\n    DispatchService -&gt;&gt; DriverApp : pushOrder(newDriver)\n\nelse Hết thời gian phản hồi\n    TimeoutScheduler --&gt; DispatchService : timeout()\n\n    DispatchService -&gt;&gt; DispatchService : findAnotherDriver()\n\n    DispatchService -&gt;&gt; DriverApp : pushOrder(newDriver)\n\nend\n\ndeactivate DispatchService\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="67RbB0KzbmXk6Qm31x6a-1">
