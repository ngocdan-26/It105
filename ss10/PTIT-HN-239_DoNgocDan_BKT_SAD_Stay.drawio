        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml RikkeiCare_UseCase_Diagram\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Bệnh nhân\&quot; as Patient\nactor \&quot;Lễ tân\&quot; as Receptionist\nactor \&quot;Bác sĩ\&quot; as Doctor\nactor \&quot;Quản lý\&quot; as Manager\n\nactor \&quot;Cổng thanh toán\&quot; as PaymentGateway &lt;&lt; External &gt;&gt;\nactor \&quot;Hệ thống Email\&quot; as EmailSystem &lt;&lt; External &gt;&gt;\n\nrectangle \&quot;Hệ thống Đặt lịch khám RikkeiCare\&quot; {\n  \n  &#39; Guest / Unauthenticated UC\n  usecase \&quot;Tìm kiếm bác sĩ\&quot; as UC_Search\n  usecase \&quot;Xem thông tin bác sĩ\&quot; as UC_ViewInfo\n  \n  &#39; Patient Authenticated UC\n  usecase \&quot;Đặt lịch khám\&quot; as UC_Booking\n  usecase \&quot;Kiểm tra khung giờ trống\&quot; as UC_CheckSlot\n  usecase \&quot;Đăng ký nhận email nhắc lịch\&quot; as UC_EmailRemind\n  \n  usecase \&quot;Thanh toán phí khám\&quot; as UC_Payment\n  usecase \&quot;Thanh toán trực tuyến\&quot; as UC_PayOnline\n  usecase \&quot;Thanh toán tại phòng khám\&quot; as UC_PayCash\n\n  &#39; Receptionist UC\n  usecase \&quot;Quản lý lịch khám\&quot; as UC_ManageAppt\n  usecase \&quot;Xác nhận bệnh nhân đến\&quot; as UC_ConfirmArrive\n  usecase \&quot;Hủy lịch khám\&quot; as UC_CancelAppt\n\n  &#39; Doctor UC\n  usecase \&quot;Xem lịch khám trong ngày\&quot; as UC_ViewDailyAppt\n  usecase \&quot;Cập nhật trạng thái khám\&quot; as UC_UpdateStatus\n\n  &#39; Manager UC\n  usecase \&quot;Xem báo cáo lượt khám &amp; doanh thu\&quot; as UC_ViewReport\n}\n\n&#39; Patient relations\nPatient --&gt; UC_Search\nPatient --&gt; UC_ViewInfo\nPatient --&gt; UC_Booking\nPatient --&gt; UC_Payment\n\n&#39; Includes &amp; Extends\nUC_Booking .&gt; UC_CheckSlot : &lt;&lt;include&gt;&gt;\nUC_EmailRemind .&gt; UC_Booking : &lt;&lt;extend&gt;&gt;\n\nUC_PayOnline .&gt; UC_Payment : &lt;&lt;extend&gt;&gt;\nUC_PayCash .&gt; UC_Payment : &lt;&lt;extend&gt;&gt;\n\n&#39; External systems\nUC_PayOnline --&gt; PaymentGateway\nUC_EmailRemind --&gt; EmailSystem\n\n&#39; Receptionist relations\nReceptionist --&gt; UC_ManageAppt\nReceptionist --&gt; UC_ConfirmArrive\nReceptionist --&gt; UC_CancelAppt\n\n&#39; Doctor relations\nDoctor --&gt; UC_ViewDailyAppt\nDoctor --&gt; UC_UpdateStatus\n\n&#39; Manager relations\nManager --&gt; UC_ViewReport\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="GzpyXa5tJxr6abA1uMBV-43">
